{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "node20",
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "useUnknownInCatchVariables": false,
    "allowJs": true,
    "checkJs": true,
    "rootDir": "src",
    "outDir": "types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/schemas/*.json"
  ]
}
